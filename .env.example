# Copy this file to .env for local development. Never commit secrets.
POSTGRES_USER=reps
POSTGRES_PASSWORD=reps-local-only
POSTGRES_DB=reps
DATABASE_URL=postgresql+psycopg://reps:reps-local-only@localhost:5432/reps
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Code execution (Milestone 3). Learner code runs only in the Docker sandbox image.
EXECUTION_ENABLED=true
EXECUTION_BACKEND=docker
SANDBOX_IMAGE=reps-sandbox:dev
SANDBOX_MEMORY_MB=256
WORKER_CONCURRENCY=2

# AI interviewer/evaluator (Milestone 4+). Leave LLM_PROVIDER=offline to use deterministic
# built-in policies. Setting openai sends bounded interview context to OpenAI (see /privacy).
LLM_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
